{
  "nodes": [
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes",
      "label": "Fig 3: Learned Jammer Shapes (spectrum and envelope) - cgan learned run001",
      "file_type": "image",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Four-panel research figure (2x2): left column is PSD relative to white vs baseband frequency (-4..4 MHz) with the victim band shaded; right column is per-symbol-slot power relative to mean (16-slot own clock). Top row is JSR -20 dB, bottom row JSR -8 dB. Purpose is to show WHAT SHAPE the learned jammer adopts in frequency and in time once a stealth term for a specific detector is added, rather than only its BER/P(det) score."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_learned_spectrum_panel",
      "label": "Learned Spectrum Panel (PSD rel. to white vs baseband frequency)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "PSD is normalised to white noise (0 dB = flat), floored at -40 dB; the title states that bins below the floor carry < 0.1 % of the power and are not identified, i.e. the floor is a readability convention, not a measurement limit."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_learned_envelope_panel",
      "label": "Learned Envelope Panel (power rel. to mean vs symbol slot, period 16)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Step-plot over a 16-slot period on the jammer's own clock (not synchronised to the victim), showing the time-domain gating/pulsing the jammer learns; -40 dB slots are effectively off."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_victim_band_rrc035",
      "label": "Victim Band (RRC roll-off 0.35), shaded overlay",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Shaded band roughly -0.68..+0.68 MHz marks where jammer power actually hurts the victim; it is the reference against which the 'in band %' legend numbers are read."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_jsr_minus20db_case",
      "label": "JSR -20 dB Operating Point (top row)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Power-starved regime: legend shows shapes diverge sharply per detector - beta=0 99 % in band / duty 0.06, Power 1-sided 99 % / 0.20, Power 2-sided 95 % / 0.06, Kurtosis 0 % in band / duty 0.61, Spectrogram CNN 52 % / 0.23."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_jsr_minus8db_case",
      "label": "JSR -8 dB Operating Point (bottom row)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Power-rich regime: every curve reaches 100 % in band with duty 0.18-0.22, and all five PSDs collapse onto one narrow in-band spike near 0 MHz - the detector-specific structure of the -20 dB row disappears."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_beta0_effectiveness_only",
      "label": "beta=0 Effectiveness-Only Jammer (no stealth term)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Black reference curve: with no detection penalty the jammer concentrates 99-100 % of power in the victim band and pulses hard (duty 0.06 at -20 dB), which is the maximally effective and maximally conspicuous shape."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_vs_power_1sided",
      "label": "Jammer Trained vs One-Sided Power Detector (beta=1)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Blue curve: keeps 99 % in band but spreads duty from 0.06 to 0.20 - an energy test only sees total power, so the jammer flattens its envelope instead of moving in frequency."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_vs_power_2sided",
      "label": "Jammer Trained vs Two-Sided Power Detector (beta=1)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Red curve: 95 % in band, duty 0.06 - stays close to the beta=0 shape, i.e. the two-sided energy test applies little shaping pressure at this JSR."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_vs_kurtosis",
      "label": "Jammer Trained vs Kurtosis Detector (beta=1)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Green curve, the extreme case at -20 dB: 0 % of power inside the victim band and duty 0.61. A kurtosis test punishes bursty, peaky signals, so the jammer becomes near-continuous and exits the band entirely - stealth bought by abandoning effectiveness."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_vs_spectrogram_cnn",
      "label": "Jammer Trained vs Spectrogram CNN Detector (beta=1)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Orange curve: intermediate compromise at -20 dB - 52 % in band, duty 0.23, splitting power between the victim band and an out-of-band lobe near +0.8 MHz, because the CNN sees the joint time-frequency pattern rather than energy alone."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_in_band_power_fraction",
      "label": "In-Band Power Fraction Metric (% in band)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_duty_cycle",
      "label": "Duty Cycle Metric (fraction of symbol slots active)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_detector_specific_evasion_finding",
      "label": "Finding: Detector Identity Selects the Evasion Shape at Low JSR",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "At JSR -20 dB the five curves are qualitatively different objects, and each difference maps onto the statistic it is hiding from: energy tests push the envelope flat, kurtosis pushes the jammer out of band and near-continuous, the CNN forces a split time-frequency compromise. The learned jammer is therefore not a single 'stealthy waveform' but a per-detector solution."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_shape_convergence_finding",
      "label": "Finding: Shapes Converge Once Power Is Plentiful (JSR -8 dB)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All five configurations land on 100 % in band with duty 0.18-0.22 and near-identical PSDs at -8 dB, suggesting the stealth term only bites when the power budget is tight; at high JSR the detection penalty is outweighed and every jammer reverts to the effectiveness-optimal in-band shape."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig3_shapes_psd_floor_convention",
      "label": "-40 dB PSD Floor Convention (bins below carry < 0.1 % of power)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig3_shapes.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Stated in both subplot titles so a reader does not over-interpret the deep notches: floored bins are negligible power, not identified structure."
    }
  ],
