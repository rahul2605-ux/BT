    {"id": "artifacts_cgan_c2_calibration_optimal_sps4_panel", "label": "Panel 2: Optimal Jammer Monte Carlo at sps=4 (rms-best)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "centre panel", "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "artifacts_cgan_c2_calibration_optimal_sps8_panel", "label": "Panel 3: Optimal Jammer Monte Carlo at sps=8 (cross-best)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "right panel", "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "artifacts_cgan_c2_calibration_ber_vs_jsr", "label": "BER vs Jamming-to-Signal Ratio (-10 to 10 dB)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "both axes, all panels", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JSR sweep -10..10 dB with log-scale BER is Zhou's evaluation protocol; reproducing it is what makes the calibration comparable to the paper's Fig. 6."},
    {"id": "artifacts_cgan_c2_calibration_zhou_fig6_reference", "label": "Zhou Fig. 6 Digitised Reference Points", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "legend markers: orange circles (Noise), blue circles (Optimal), grey circles (paper point, not fitted)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grey markers are labelled 'paper point, not fitted' — held out of the fit, so at least one digitised point per curve acts as an unused check rather than being absorbed by the calibration."},
    {"id": "artifacts_cgan_c2_calibration_rms_decade_fit", "label": "RMS Decade Error and 1e-3 Offset Fit Metrics", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "legend annotations, e.g. 'rms 0.79 dec, 1e-3 off 2.43 dB'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two complementary scores: RMS error in decades of BER measures whole-curve agreement, while the JSR offset at BER=1e-3 measures horizontal shift at the operating point that matters."},
    {"id": "artifacts_cgan_c2_calibration_sps_parameter", "label": "Samples-per-Symbol Choice (sps=4 vs sps=8)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "legend: 'sps=4 full', 'sps=8 full'; panel titles", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An unstated Zhou link parameter being swept as a calibration axis; sps=4 gives the lower RMS (0.79 dec) for noise while sps=8 gives the smaller 1e-3 offset (0.64 dB), so the two panels report rms-best and cross-best separately instead of picking one silently."},
    {"id": "artifacts_cgan_c2_calibration_async_jammer_fit", "label": "Async RRC-0.25 Optimal Jammer (best fit)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "blue dashed curve, legend 'async, rrc0.25: rms 0.98, 1e-3 off 0.63 dB'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Best of the three jammer synchronisation hypotheses (rms ~1.0 dec vs 2.6-3.2 for random-phase and locked), so Zhou's 'optimal' same-modulation jammer is inferred to be asynchronous with the victim rather than symbol-locked."},
    {"id": "artifacts_cgan_c2_calibration_locked_jammer_fit", "label": "Symbol-Locked Optimal Jammer Hypothesis (rejected)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "solid grey curve, legend 'locked, rect / rrc0.35: rms 3.15, 1e-3 off 6.29 dB'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Produces a near-step BER cliff with zero errors below about -2 dB JSR; worst fit (rms 3.15 dec, 6.29 dB offset), so a phase- and symbol-locked jammer does not explain Zhou's measured curve."},
    {"id": "artifacts_cgan_c2_calibration_random_phase_jammer_fit", "label": "Random-Phase Optimal Jammer Hypothesis (intermediate)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "grey dash-dot curve, legend 'random_phase, rrc0.5 / rrc0.25: rms ~2.6, 1e-3 off 4.35 dB'", "source_url": null, "captured_at": null, "author": null, "contributor": null},
    {"id": "artifacts_cgan_c2_calibration_q_function_baseline", "label": "Analytic Q-Function Noise-Jammer Reference (g=7.2 dB)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "black dotted curve, legend 'any Q-function, best: g=7.2 dB, rms 0.45'", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single-parameter closed-form Q-function fit reaches rms 0.45 dec, better than either simulated sps setting, which bounds how much of the residual mismatch is link modelling rather than digitisation noise."},
    {"id": "artifacts_cgan_c2_calibration_zero_error_convention", "label": "Zero-Error Points Plotted at the 95% Confidence Bound", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "y-axis label and downward-triangle markers near 1e-7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Monte Carlo trials that observe no bit errors cannot be plotted on a log axis, so they are drawn as triangles at the 95% upper bound implied by the trial count — an honest floor instead of an invented BER."},
    {"id": "artifacts_cgan_c2_calibration_unstated_parameter_calibration", "label": "Calibration of Zhou's Unstated Link Parameters (C2)", "file_type": "concept", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": "figure as a whole", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zhou 2025 leaves sps, pulse-shaping roll-off and jammer synchronisation unstated; this figure fits those choices to the digitised Fig. 6 curves so the CGAN reproduction runs on a link whose baselines match the paper."}
  ],
