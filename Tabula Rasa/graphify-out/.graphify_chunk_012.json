    {"id": "artifacts_cgan_c2_calibration", "label": "C2 Calibration Figure (BER vs JSR, three panels)", "file_type": "image", "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/c2_calibration.png", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null},
