      "author": null,
      "contributor": null
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_zhou2025_fig6",
      "label": "Zhou 2025 Fig. 6 Digitised Reference Points",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Open circles overlay the three solid 'ours' curves so the reproduction can be judged point-by-point against the source paper rather than by eye on a redrawn axis; plotted as scatter (not a line) because they are digitised from a published figure, not measured here."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_gan_jammer",
      "label": "GAN Jammer (CGAN Generator Waveform)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Green curve; the reproduction target. Its measured curve sits essentially on top of the Optimal curve from about -5 dB JSR upward and saturates near BER 0.5, i.e. the CGAN jammer matches the matched-modulation optimum rather than beating it."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_optimal_jammer",
      "label": "Optimal (Matched-Modulation) Jammer Baseline",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Blue curve; Zhou's same-modulation jammer, the strongest baseline in the paper. Included so the GAN is scored against the best non-learned jammer, not only against Gaussian noise."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_noise_jammer",
      "label": "Gaussian Noise Jammer Baseline",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Orange curve, the weakest jammer: it needs roughly 5 dB more JSR than GAN/Optimal to cross BER 1e-3 and never saturates within the swept range, which is the expected ordering and acts as a sanity floor on the link model."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_qpsk_link_snr30",
      "label": "QPSK Waveform Link at SNR 30 dB",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Evaluation condition stated in the figure title; SNR is fixed at 30 dB so that the swept JSR from -10 to +10 dB is the only variable driving BER."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_jsr_sweep",
      "label": "JSR Sweep Axis (-10 to +10 dB)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Jamming-to-signal ratio is the hard power budget imposed on the transmitted jammer waveform, so sweeping it is how effectiveness is read off at matched power rather than at matched configuration."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_measurement_floor",
      "label": "BER Measurement Floor (Censored Low-JSR Points)",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Downward triangle markers pin all three 'ours' curves to about 3e-9 at JSR -10 and -8 dB: zero bit errors were observed, so the value is an upper bound, not a measurement. Zhou's own points at those JSRs (down to 1e-10) lie below what the stated 1e4 symbols x 100 trials protocol can resolve, so the low-JSR disagreement is a reporting artefact rather than a reproduction failure."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_ber_1e3_line",
      "label": "BER = 1e-3 Reference Line",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dashed horizontal guide that turns the log-BER curves into a readable operating point: the JSR at which each jammer crosses 1e-3 is the single-number comparison between GAN, Optimal and Noise."
    },
    {
      "id": "artifacts_cgan_run001_ber_vs_jsr_reproduction_finding",
      "label": "Reproduction Finding: GAN Tracks Optimal, Both Beat Noise",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/run001_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The measured curves reproduce Zhou's ordering and saturation level (BER ~0.5 for GAN and Optimal above 0 dB JSR, ~0.2 for Noise at +10 dB) and the digitised points fall close to the curves over the mid and high JSR range; the visible disagreement is confined to the low-JSR tail where neither protocol can measure."
    }
  ],
