    {
      "id": "artifacts_cgan_learned_run001_fig5_ber_vs_jsr_jsr_advantage_finding",
      "label": "Finding: learned shaping wins ~10-20 dB of JSR over every classical baseline at low BER",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig5_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The learned beta=0 curve leaves the 1e-6 BER floor near -24 dB JSR and reaches 1e-3 by about -20 dB, whereas matched QPSK needs roughly -8 dB and barrage noise roughly -4 dB for the same BER; pulsed p=0.1 tracks the learned curve only above about -13 dB and then saturates near 1e-1 while matched QPSK overtakes it. The white theta=0 control stays pinned at the BER floor until about -4 dB, i.e. it behaves like barrage noise, so the advantage is attributable to the learned shaping."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig5_ber_vs_jsr_ber_saturation_ceiling",
      "label": "High-JSR saturation ceiling: shaped and pulsed jammers plateau near BER 0.15 while matched QPSK reaches ~0.45",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig5_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The shaped curve is only measured up to 0 dB JSR and its last point sits at ~0.16, where matched QPSK is already ~0.3 and still climbing; the shaping advantage is therefore a low-JSR (power-starved) advantage, not a higher achievable maximum BER."
    },
    {
