    {
      "id": "artifacts_cgan_learned_run001_fig5_ber_vs_jsr_shaped_learned_beta0",
      "label": "Shaped jammer, beta=0 (learned) - black square curve",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig5_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "beta=0 sets the attacker reward BER - beta*detections to pure effectiveness, so this curve isolates what waveform shaping buys before any stealth penalty is applied; it is the upper bound the stealth-constrained (beta>0) runs are measured against."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig5_ber_vs_jsr_shaped_theta0_white",
      "label": "Shaped theta=0 (white) - untrained/control initialisation, grey dotted",
      "file_type": "concept",
      "source_file": "/home/rrahman/BT/Tabula Rasa/artifacts/cgan/learned/run001/fig5_ber_vs_jsr.png",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Included as the control: the same shaped-jammer parameterisation with its shaping parameters zeroed, so any separation between it and the learned curve is attributable to learning rather than to the parameterisation or the evaluation harness."
    },
    {
      "id": "artifacts_cgan_learned_run001_fig5_ber_vs_jsr_noise_barrage",
      "label": "Noise (barrage) jammer baseline - blue curve",
